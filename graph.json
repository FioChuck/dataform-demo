        {
            "query": "\n\nWITH\n  expected_titles AS (\n  SELECT\n    'Alphabet_Inc.' AS title\n  UNION ALL\n  SELECT\n    'Microsoft'\n  UNION ALL\n  SELECT\n    'Amazon_(company)'\n  UNION ALL\n  SELECT\n    'Apple_Inc.'\n  UNION ALL\n  SELECT\n    'Meta_Platforms' ),\n  daily_title_counts AS (\n  SELECT\n    day,\n    COUNT(DISTINCT title) AS actual_title_count\n  FROM\n    `cf-data-analytics.wikipedia.daily_pageviews_24`\n  GROUP BY\n    day ),\n  total_expected_titles AS (\n  SELECT\n    COUNT(DISTINCT title) AS count_expected\n  FROM\n    expected_titles )\nSELECT\n  dtc.day,\n  dtc.actual_title_count,\n  tet.count_expected\nFROM\n  daily_title_counts AS dtc,\n  total_expected_titles AS tet\nWHERE\n  dtc.actual_title_count != tet.count_expected\n",
