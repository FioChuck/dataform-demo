            },
            "query": "\n\nSELECT\n  title,\n  DATE(datehour) AS day,\n  SUM(views) AS total_views\nFROM\n  `bigquery-public-data.wikipedia.pageviews_2024`\nWHERE\n  DATE(datehour) BETWEEN '2024-01-01'\n  AND '2024-12-31'\n  AND wiki = 'en'\n  AND title IN (\"Alphabet_Inc.\",\n    \"Microsoft\",\n    \"Amazon_(company)\",\n    \"Apple_Inc.\",\n    \"Meta_Platforms\")\nGROUP BY\n  title,\n  day",
            "disabled": false,
