            "query": "\n\nSELECT\n  wiki_data.en_wiki,\n  `cf-data-analytics.wikipedia.clean_string`(wiki_data.en_wiki) AS page,\n  wiki_data.en_description,\n  SUM(pageviews.views) AS total_views\nFROM\n  `bigquery-public-data.wikipedia.wikidata` AS wiki_data\nLEFT JOIN\n  `bigquery-public-data.wikipedia.pageviews_2024` AS pageviews\nON\n  wiki_data.en_wiki = pageviews.title\nWHERE\n  DATE(pageviews.datehour) BETWEEN '2024-01-01'\n  AND '2024-12-31'\n  AND wiki_data.numeric_id IN (20800404,\n    2283,\n    3884,\n    312,\n    380)\n  AND wiki_data.type = \"item\"\n  AND wiki_data.fake_date = \"2000-01-01\"\nGROUP BY\n  1,\n  2,\n  3\n",
