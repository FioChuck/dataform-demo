{
    "name": "Dataform Dev Container",
    "build": {
        "dockerfile": "../Dockerfile",
        "context": ".."
    },
    "workspaceFolder": "/app",
    "workspaceMount": "source=${localWorkspaceFolder},target=/app,type=bind",
    "initializeCommand": "mkdir -p ~/.config/gcloud ~/.antigravitycli ~/.gemini",
    "mounts": [
        "source=${localEnv:HOME}/.config/gcloud,target=/home/vscode/.config/gcloud,type=bind,consistency=cached",
        "source=${localEnv:HOME}/.antigravitycli,target=/home/vscode/.antigravitycli,type=bind,consistency=cached",
        "source=${localEnv:HOME}/.gemini,target=/home/vscode/.gemini,type=bind,consistency=cached"
    ],
    "containerEnv": {
        "PYTHONUNBUFFERED": "1",
        "PYTHONPATH": "/app",
        "GOOGLE_CLOUD_REGION": "us-central1",
        "GOOGLE_CLOUD_PROJECT": "cf-data-analytics",
        "SHELL": "/bin/bash",
        "GOOGLE_APPLICATION_CREDENTIALS": "/home/vscode/.config/gcloud/application_default_credentials.json"
    },
    "customizations": {
        "vscode": {
            "settings": {
                "terminal.integrated.defaultProfile.linux": "bash",
                "python.defaultInterpreterPath": "/usr/local/bin/python",
                "python.analysis.extraPaths": [
                    "/app"
                ],
                "python.autoComplete.extraPaths": [
                    "/app"
                ],
                "python.analysis.languageServer": "Pylance",
                "[python]": {
                    "editor.defaultFormatter": "charliermarsh.ruff",
                    "editor.formatOnSave": true,
                    "editor.codeActionsOnSave": {
                        "source.organizeImports": "explicit"
                    }
                },
                "dataform.compileOnSave": true,
                "files.associations": {
                    "*.sqlx": "sqlx"
                }
            },
            "extensions": [
                "dataform.dataform",
                "redhat.vscode-yaml",
                "ms-python.python",
                "ms-python.vscode-pylance",
                "ms-python.debugpy",
                "ms-toolsai.jupyter",
                "ms-toolsai.jupyter-renderers",
                "charliermarsh.ruff",
                "meta.pyrefly",
                "GoogleCloudTools.cloudcode",
                "GoogleCloudTools.datacloud",
                "Google.geminicodeassist"
            ]
        }
    },
    "postCreateCommand": "dataform --version && dataform compile",
    "remoteUser": "vscode"
}
